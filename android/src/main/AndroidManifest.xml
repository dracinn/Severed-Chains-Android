<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-feature android:glEsVersion="0x00030002" android:required="true" />
  <uses-permission android:name="android.permission.INTERNET" />
  <!-- Shared log files in Documents/Severed Chains/logs (API 26-28 only; 29+ uses MediaStore) -->
  <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
  <!-- User-managed Documents/Severed Chains/mods drop-in folder -->
  <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
  <application
      android:label="Severed Chains"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
      android:largeHeap="true"
      android:allowBackup="false">
    <!-- Request ANGLE (GLES-over-Vulkan) where the platform honors it:
         Android 17+ reads prefer_angle; AOSP/LineageOS builds read
         GLES_MODE. Ignored elsewhere - devices without ANGLE keep the
         native driver. The developer-option driver picker remains the
         manual workaround for buggy vendor GLES drivers. -->
    <meta-data android:name="com.android.graphics.driver.prefer_angle" android:value="true" />
    <meta-data android:name="com.android.angle.GLES_MODE" android:value="angle" />
    <activity
        android:name="legend.game.android.MainActivity"
        android:exported="true"
        android:screenOrientation="landscape"
        android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
  </application>
</manifest>
